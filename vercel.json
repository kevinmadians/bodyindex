{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/assets/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/(favicon\\.ico|favicon\\.svg|favicon\\.png|favicon-.*\\.png|android-chrome-.*\\.png|apple-touch-icon\\.png|logo\\.png)", "dest": "/$1", "headers": { "cache-control": "public, max-age=86400" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
} 